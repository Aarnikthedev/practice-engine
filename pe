<div class="hint" id="pst" role="status" style="margin-top:10px"></div>
<p class="hint" style="margin:8px 0 0">Only structure is used. Questions are never copied; new original questions are generated.</p>
<div id="patbox" class="hide" style="margin-top:14px"><label for="pat">Detected pattern — review and edit before generating</label><textarea id="pat" rows="7"></textarea></div></fieldset>
<div id="msg" class="err" role="alert"></div><button class="btn lg" type="submit">Generate My Sample Paper</button></form></main>

<main id="loading" class="pg hide"><div class="load" role="status"><div class="spin"></div><h2 id="ls">Generating your paper…</h2><p style="color:var(--mu)" id="lm">This usually takes under a minute.</p><div id="lerr"></div></div></main>

<main id="paperv" class="pg hide" style="max-width:900px"><div class="tb noprint">
<div class="tabs"><button id="t1" class="on" onclick="tab(1)">Question paper</button><button id="t2" onclick="tab(2)">Answer key</button></div>
<button class="btn o" onclick="window.print()">Print / Save as PDF</button><button class="btn o" onclick="dl()">Download file</button><button class="btn o" onclick="save()">Save to My Papers</button><button class="btn" onclick="startAtt()">Attempt online</button><button class="btn o" onclick="gen()">Regenerate</button><button class="btn o" onclick="go('create')">Edit details</button></div>
<div id="issues"></div><div class="paper" id="qp"></div><div class="paper hide" id="kp"></div>
